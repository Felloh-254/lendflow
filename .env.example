APP_NAME=LendFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=lendflow
DB_USERNAME=lendflow
DB_PASSWORD=secret
DB_FORWARD_PORT=5432

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_FORWARD_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# --- JWT (tymon/jwt-auth) ---
JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=20160
# 15 min access token, 14 day refresh token (minutes)

# --- CORS ---
FRONTEND_URL=http://localhost:5173
